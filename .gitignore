# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
htmlcov/
.coverage

# 环境变量与密钥
.env
.env.local

# 数据（体积大，不入库）
data/videos/*
data/snapshots/*
data/calibrations/*.json
!data/videos/.gitkeep
!data/snapshots/.gitkeep
!data/calibrations/.gitkeep
!data/samples/.gitkeep

# 检测过程日志
*.jsonl

# 模型权重
*.pt
*.onnx
*.engine

# 训练与实验产物
runs/
experiments/outputs/*
!experiments/outputs/.gitkeep

# 前端
node_modules/
dist/
.vite/

# Java / Maven
target/
*.class
*.jar
!maven-wrapper.jar

# 编辑器与系统
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log

# WorkBuddy 项目数据：只保留 memory 笔记，其余会话/缓存不入库
.workbuddy/*
!.workbuddy/memory/
