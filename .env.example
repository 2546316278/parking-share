# 复制为 .env 后填写真实值，.env 已被 .gitignore 排除
# 切记：任何密钥都不要写进代码、不要提交到 git

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shared_parking

# ---------- JWT ----------
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_me_with_random_hex
JWT_EXPIRE_HOURS=24

# ---------- 视觉服务 ----------
YOLO_MODEL=yolov8n.pt
CAMERA_SOURCE=0
CALIB_FILE=data/calibrations/default.json
DETECT_INTERVAL=1.0
